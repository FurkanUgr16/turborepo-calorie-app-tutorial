{
  "name": "calorie-ai-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@cloudflare/workers-types": "^5.20260728.1",
      "better-auth": "1.6.27",
      "@better-auth/expo": "1.6.27"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F server --",
    "db:generate": "turbo run db:generate -F @calorie-ai-app/db --",
    "deploy": "turbo run deploy -F @calorie-ai-app/infra --",
    "destroy": "turbo run destroy -F @calorie-ai-app/infra --"
  },
  "dependencies": {
    "@calorie-ai-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@calorie-ai-app/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.12"
}
