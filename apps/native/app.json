{
  "expo": {
    "scheme": "calorie-ai-app",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "calorie-ai-app",
    "slug": "calorie-ai-app",
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      ["expo-camera"],
      ["expo-image-picker"],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
